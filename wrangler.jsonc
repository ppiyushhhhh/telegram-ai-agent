{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-ai-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Non-sensitive runtime variables for local development
  "vars": {
    "APP_ENV": "development",
    "LOG_LEVEL": "debug",
    "PRIMARY_AI_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_TEMPERATURE": "0.7",
    "MAX_TOKENS": "1000",
    "RATE_LIMIT_PER_MINUTE": "20"
  },
  // Cloudflare Workers AI binding (Edge-native serverless models)
  "ai": {
    "binding": "AI"
  },
  // 1. Cloudflare D1 Database binding (Relational memory, users, chats, audit logs)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-ai-agent-d1-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 2. Cloudflare R2 Bucket binding (Media attachments, voice notes, documents)
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "telegram-ai-agent-r2-local"
    }
  ],
  // 3. Cloudflare Durable Objects binding (Stateful sessions & atomic locking)
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ],
  // ===========================================================================
  // Environment Configurations (UAT & LIVE)
  // ===========================================================================
  "env": {
    // -------------------------------------------------------------------------
    // UAT Environment (Staging & Integration Testing)
    // -------------------------------------------------------------------------
    "uat": {
      "name": "telegram-ai-agent-uat",
      "vars": {
        "APP_ENV": "uat",
        "LOG_LEVEL": "info",
        "PRIMARY_AI_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_TEMPERATURE": "0.7",
        "MAX_TOKENS": "1000",
        "RATE_LIMIT_PER_MINUTE": "30",
        "TELEGRAM_BOT_USERNAME": "ppiyushhhhBot",
        "ALLOWED_TELEGRAM_USER_IDS": "9084869490"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "telegram-ai-agent-d1-uat",
          "database_id": "822915c4-31bc-4e99-b585-f047d7bb04a6",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SESSION_DO",
            "class_name": "SessionDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["SessionDurableObject"]
        }
      ]
      // R2 bucket can be enabled when Cloudflare R2 is activated on the account:
      // "r2_buckets": [
      //   {
      //     "binding": "MEDIA_BUCKET",
      //     "bucket_name": "telegram-ai-agent-r2-uat"
      //   }
      // ]
    },
    // -------------------------------------------------------------------------
    // LIVE Environment (Production)
    // -------------------------------------------------------------------------
    "live": {
      "name": "telegram-ai-agent-live",
      "vars": {
        "APP_ENV": "production",
        "LOG_LEVEL": "warn",
        "PRIMARY_AI_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_TEMPERATURE": "0.7",
        "MAX_TOKENS": "1500",
        "RATE_LIMIT_PER_MINUTE": "60"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "telegram-ai-agent-d1-live",
          // Set to your Cloudflare D1 UUID after running: wrangler d1 create telegram-ai-agent-d1-live
          "database_id": "TODO_REPLACE_WITH_LIVE_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "telegram-ai-agent-r2-live"
        }
      ]
    }
  }
}
