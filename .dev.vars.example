# ==============================================================================
# Local Development & Secrets Template (.dev.vars)
#
# INSTRUCTIONS:
# 1. Copy this file to '.dev.vars' for local development:
#    cp .dev.vars.example .dev.vars
# 2. Fill in your valid API keys and secrets.
# 3. DO NOT commit .dev.vars to Git (it is ignored by default in .gitignore).
#
# FOR UAT / LIVE ENVIRONMENTS:
# Never commit secrets to repository or wrangler.jsonc. Instead set them using:
#    npx wrangler secret put TELEGRAM_BOT_TOKEN --env uat
#    npx wrangler secret put TELEGRAM_WEBHOOK_SECRET --env uat
#    npx wrangler secret put OPENAI_API_KEY --env uat
#    npx wrangler secret put GEMINI_API_KEY --env uat
#    npx wrangler secret put ADMIN_API_KEY --env uat
# ==============================================================================

# Application environment ('development', 'uat', 'production')
APP_ENV=development

# Logging level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=debug

# Telegram Bot API Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE

# Secret token used by Telegram webhook header (X-Telegram-Bot-Api-Secret-Token)
# Generate a random 32+ character hex or alphanumeric string
TELEGRAM_WEBHOOK_SECRET=replace_with_a_secure_random_token_min_16_chars

# AI Provider Selection: 'gemini' (primary) | 'workers-ai' (secondary) | 'openai' (optional)
PRIMARY_AI_PROVIDER=gemini

# Google Gemini API Configuration (Primary Provider)
GEMINI_API_KEY=AIzaSyExample1234567890abcdefghijklmnopqrstuvwxyz
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare Workers AI Configuration (Secondary Edge-Native Provider - zero external API key needed)
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct

# OpenAI Configuration (Optional Tertiary Provider - only used if OPENAI_API_KEY is supplied)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
MAX_TOKENS=1000

# Private bot access control (numeric Telegram user ID allowlist)
# Only approved Telegram user IDs can access the bot
ALLOWED_TELEGRAM_USER_IDS=9084869490

# Bot public username (without @ symbol)
TELEGRAM_BOT_USERNAME=PiyushPersonalAssistantBot

# Internal Admin API Key for protected endpoints (dashboard / management)
ADMIN_API_KEY=change_me_to_a_secure_admin_key_for_internal_api
