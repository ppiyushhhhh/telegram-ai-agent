# ==============================================================================
# Local Development & Secrets Template (.dev.vars)
#
# INSTRUCTIONS:
# 1. Copy this file to '.dev.vars' for local development:
#    cp .dev.vars.example .dev.vars
# 2. Fill in your valid API keys and secrets.
# 3. DO NOT commit .dev.vars to Git (it is ignored by default in .gitignore).
#
# FOR UAT / LIVE ENVIRONMENTS:
# Set secrets using:
#    npx wrangler secret put TELEGRAM_BOT_TOKEN --env uat
#    npx wrangler secret put TELEGRAM_WEBHOOK_SECRET --env uat
#    npx wrangler secret put ADMIN_API_KEY --env uat
#
# Note: Cloudflare Workers AI runs natively via bindings. Zero external AI API keys needed.
# ==============================================================================

# Application environment ('development', 'uat', 'production')
APP_ENV=development

# Logging level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=debug

# Telegram Bot API Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE

# Secret token used by Telegram webhook header (X-Telegram-Bot-Api-Secret-Token)
# Generate a random 32+ character hex or alphanumeric string
TELEGRAM_WEBHOOK_SECRET=replace_with_a_secure_random_token_min_16_chars

# AI Provider: Cloudflare Workers AI is the sole provider
PRIMARY_AI_PROVIDER=workers-ai

# Cloudflare Workers AI Configuration (Serverless Edge AI - no API key needed)
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

AI_TEMPERATURE=0.7
MAX_TOKENS=1000

# Private bot access control (numeric Telegram user ID allowlist)
# Only approved Telegram user IDs can access the bot
ALLOWED_TELEGRAM_USER_IDS=9084869490

# Admin Dashboard API Key for authentication
ADMIN_API_KEY=replace_with_a_secure_admin_key
